<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FnafSelfHost</AssemblyName>
    <RootNamespace>FnafSelfHost</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Folder where you unzipped the GameJolt build AND installed BepInEx. Override: dotnet build -p:GameDir="D:\Games\fnaf" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Games\fnaf-online-0.9.6-alpha</GameDir>
    <InteropDir>$(GameDir)\BepInEx\interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="Open.NAT.Core" Version="2.1.0.5" />
  </ItemGroup>

  <!-- These DLLs are generated by BepInEx the first time you launch the game with it installed. -->
  <ItemGroup>
    <Reference Include="$(InteropDir)\*.dll" Private="false" />
  </ItemGroup>

</Project>
