<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>InteropGen</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <CoreDir>$(BepInExCore)</CoreDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(CoreDir)/*.dll" Exclude="$(CoreDir)/BepInEx.*.dll;$(CoreDir)/Il2CppInterop.HarmonySupport.dll;$(CoreDir)/Il2CppInterop.Runtime.dll;$(CoreDir)/0Harmony.dll;$(CoreDir)/MonoMod.*.dll" Private="true" />
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(CoreDir)/Il2CppInterop.Runtime.dll</HintPath></Reference>
  </ItemGroup>
</Project>
